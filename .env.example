# ---------------------------------------------------------------------------
# Local development environment (generated by setup script)
# The project-local PostgreSQL cluster runs on port 5433 (see scripts/db-start.ps1)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres@localhost:5433/customer_intelligence?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL=info

# Synthetic data generation
DATA_SEED=20261022
DATA_PROFILE=small

# Optional LLM narrative layer. Leave empty to run fully deterministic explanations.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Frontend
NEXT_PUBLIC_API_BASE_URL=/api
