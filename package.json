{
  "name": "customer-intelligence-platform",
  "private": true,
  "version": "1.0.0",
  "description": "YottaFlex.ai Associate AI Forward Deployed Engineer hackathon - Customer Intelligence & Action Recommendation Platform",
  "scripts": {
    "db:start": "pwsh -File scripts/db-start.ps1",
    "db:stop": "pwsh -File scripts/db-stop.ps1",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:generate": "npm --prefix backend run db:generate",
    "db:seed": "npm --prefix backend run db:seed",
    "data:generate": "python data-engine/main.py --profile small",
    "data:load": "npm --prefix backend run data:load",
    "pipeline": "pwsh -File scripts/run-pipeline.ps1",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "validate": "npm --prefix backend run validate"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
